/* ==========================================
   MOBILE PORTFOLIO - CLEAN DESIGN
   ========================================== */

@media (max-width: 768px) {

    /* ==========================================
       HIDE TOP NAVBAR
       ========================================== */
    .nav,
    .top-nav,
    .site-header,
    header {
        display: none !important;
    }

    /* ==========================================
       BASE STYLES
       ========================================== */
    html {
        scroll-behavior: smooth;
    }

    body {
        background: #000000;
        color: #ffffff;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
    }

    /* ==========================================
       SECTION BASE
       ========================================== */
    section {
        padding: 48px 16px;
        max-width: 100%;
    }

    .section-header {
        text-align: center;
        margin-bottom: 24px;
    }

    .section-label {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.65rem;
        color: #007aff;
        text-transform: uppercase;
        letter-spacing: 2px;
        margin-bottom: 8px;
    }

    .section-title {
        font-size: 1.35rem;
        font-weight: 800;
        margin-bottom: 6px;
    }

    .section-subtitle {
        font-size: 0.85rem;
        color: #86868b;
        line-height: 1.45;
    }

    /* ==========================================
       HERO SECTION - CLEAN
       ========================================== */
    .hero {
        min-height: 100vh;
        padding: 48px 16px 100px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        background: #000000;
    }

    .hero-grid {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 16px;
    }

    /* Hide all decorative elements */
    .hero-orb,
    .hero-particles,
    .hero-particle,
    .hero-profile-overlay,
    .hero-profile-glow,
    .hero-profile-ring {
        display: none !important;
    }

    /* Profile Image */
    .hero-image-wrapper {
        order: -1;
        margin-bottom: 8px;
    }

    .hero-profile-card {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        border: 2px solid rgba(255, 255, 255, 0.15);
        overflow: hidden;
    }

    .hero-profile-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: grayscale(100%);
    }

    /* Hero Content */
    .hero-content {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    /* Hero Label */
    .hero-label {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.65rem;
        color: #007aff;
        text-transform: uppercase;
        letter-spacing: 2px;
        margin-bottom: 8px;
    }

    .hero-label::before {
        display: none !important;
    }

    /* Badge */
    .mobile-badge {
        display: inline-flex !important;
        align-items: center;
        gap: 6px;
        padding: 4px 10px;
        background: rgba(0, 122, 255, 0.1);
        border: 1px solid rgba(0, 122, 255, 0.25);
        border-radius: 16px;
        font-size: 0.6rem;
        color: #5ac8fa;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 26px;
    }

    .mobile-badge::before {
        content: '';
        width: 4px;
        height: 4px;
        background: #34c759;
        border-radius: 50%;
    }

    /* Hero Title - Show only one name */
    .hero-title {
        margin: 0 !important;
        padding: 0 !important;
        height: auto !important;
        min-height: auto !important;
        overflow: visible !important;
    }

    /* Hide the glitch name container */
    .hero-title-single {
        display: none !important;
    }

    /* Show a clean simple title */
    .hero-title::after {
        content: 'Vineet Kishore';
        display: block;
        font-size: 1.5rem;
        font-weight: 800;
        color: #ffffff;
        letter-spacing: -0.02em;
    }

    /* Hide all glitch names */
    .glitch-name {
        display: none !important;
    }

    /* Hero Subtitle */
    .hero-subtitle {
        font-size: 0.85rem;
        color: #86868b;
        line-height: 1.5;
        margin: 26px 0 20px;
        max-width: 280px;
    }

    /* Hero CTAs */
    .hero-cta-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
        width: 100%;
        max-width: 260px;
        margin-bottom: 20px;
    }

    .hero-cta-primary,
    .hero-cta-secondary {
        padding: 12px 20px;
        border-radius: 10px;
        font-size: 0.85rem;
        font-weight: 600;
        text-align: center;
        text-decoration: none;
    }

    .hero-cta-primary {
        background: #007aff;
        color: #ffffff;
    }

    .hero-cta-secondary {
        background: rgba(255, 255, 255, 0.08);
        color: #ffffff;
        border: 1px solid rgba(255, 255, 255, 0.12);
    }

    /* Hero Stats */
    .hero-stats {
        display: flex;
        gap: 8px;
        overflow-x: auto;
        scrollbar-width: none;
        padding-bottom: 4px;
    }

    .hero-stats::-webkit-scrollbar {
        display: none;
    }

    .hero-stat {
        flex: 0 0 auto;
        min-width: 70px;
        padding: 10px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 8px;
        text-align: center;
    }

    .hero-stat-value {
        font-size: 1rem;
        font-weight: 700;
        color: #007aff;
        display: block;
    }

    .hero-stat-label {
        font-size: 0.55rem;
        color: #6e6e73;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    /* ==========================================
       ABOUT SECTION
       ========================================== */
    .about-grid {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .about-card {
        background: #0d0d0d;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px;
        padding: 16px;
    }

    .about-card-icon {
        width: 36px;
        height: 36px;
        background: rgba(0, 122, 255, 0.15);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        margin-bottom: 10px;
    }

    .about-card-title {
        font-size: 0.9rem;
        font-weight: 700;
        margin-bottom: 6px;
    }

    .about-card-text {
        font-size: 0.8rem;
        color: #a1a1a6;
        line-height: 1.5;
    }

    /* ==========================================
       EXPERIENCE SECTION
       ========================================== */
    .timeline-container {
        padding-left: 0;
    }

    .timeline-item {
        margin-bottom: 10px;
    }

    .timeline-line,
    .timeline-progress,
    .timeline-dot,
    .timeline-item::before,
    .timeline-item::after {
        display: none !important;
    }

    .timeline-card {
        background: #0d0d0d;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-left: 3px solid #007aff;
        border-radius: 12px;
        padding: 14px;
    }

    .timeline-date {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.65rem;
        color: #007aff;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 4px;
    }

    .timeline-title {
        font-size: 0.9rem;
        font-weight: 700;
        margin-bottom: 2px;
    }

    .timeline-company {
        font-size: 0.8rem;
        color: #a1a1a6;
        margin-bottom: 8px;
    }

    .timeline-desc {
        font-size: 0.8rem;
        color: #c7c7cc;
        line-height: 1.45;
        margin-bottom: 10px;
    }

    .timeline-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .timeline-tag {
        padding: 4px 8px;
        background: rgba(0, 122, 255, 0.1);
        border: 1px solid rgba(0, 122, 255, 0.2);
        border-radius: 12px;
        font-size: 0.6rem;
        color: #5ac8fa;
        font-family: 'JetBrains Mono', monospace;
    }

    /* ==========================================
       PROJECTS SECTION - COMPACT
       ========================================== */
    .project-filters {
        display: flex;
        gap: 8px;
        margin-bottom: 16px;
        overflow-x: auto;
        scrollbar-width: none;
    }

    .project-filters::-webkit-scrollbar {
        display: none;
    }

    .filter-btn {
        padding: 6px 12px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 16px;
        font-size: 0.7rem;
        color: #86868b;
        white-space: nowrap;
    }

    .filter-btn.active {
        background: #007aff;
        border-color: #007aff;
        color: #ffffff;
    }

    .projects-cinema {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .project-cinema-card {
        background: #0d0d0d;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-left: 3px solid #007aff;
        border-radius: 12px;
        overflow: hidden;
    }

    .project-cinema-visual {
        display: none !important;
    }

    .project-cinema-content {
        padding: 14px;
    }

    .project-cinema-title {
        font-size: 0.9rem;
        font-weight: 700;
        margin-bottom: 4px;
    }

    .project-cinema-desc {
        font-size: 0.75rem;
        color: #a1a1a6;
        line-height: 1.45;
        margin-bottom: 10px;
    }

    .project-cinema-stats {
        display: flex;
        gap: 16px;
        padding-top: 10px;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
    }

    .project-cinema-stat-value {
        font-size: 0.85rem;
        font-weight: 700;
        color: #007aff;
    }

    .project-cinema-stat-label {
        font-size: 0.55rem;
        color: #6e6e73;
        text-transform: uppercase;
    }

    /* ==========================================
       SKILLS SECTION
       ========================================== */
    .skills-grid {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .skill-category {
        background: #0d0d0d;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px;
        padding: 14px;
    }

    .skill-category-title {
        font-size: 0.8rem;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .skill-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .skill-tag {
        padding: 5px 10px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px;
        font-size: 0.7rem;
        color: #a1a1a6;
    }

    /* ==========================================
       EDUCATION SECTION
       ========================================== */
    .education-grid {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .education-card {
        background: #0d0d0d;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-left: 3px solid #007aff;
        border-radius: 12px;
        padding: 14px;
    }

    .education-card-year {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.65rem;
        color: #007aff;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 4px;
    }

    .education-card-title {
        font-size: 0.85rem;
        font-weight: 700;
        margin-bottom: 2px;
    }

    .education-card-degree {
        font-size: 0.75rem;
        color: #a1a1a6;
        margin-bottom: 6px;
    }

    .education-card-desc {
        font-size: 0.75rem;
        color: #86868b;
        line-height: 1.45;
    }

    /* ==========================================
       INSIGHTS SECTION
       ========================================== */
    .insights-grid {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .insight-card {
        background: #0d0d0d;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px;
        padding: 14px;
    }

    .insight-category {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.6rem;
        color: #007aff;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 6px;
    }

    .insight-title {
        font-size: 0.85rem;
        font-weight: 700;
        margin-bottom: 6px;
        line-height: 1.35;
    }

    .insight-excerpt {
        font-size: 0.75rem;
        color: #a1a1a6;
        line-height: 1.45;
        margin-bottom: 10px;
    }

    .insight-meta {
        display: flex;
        justify-content: space-between;
        padding-top: 10px;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
        font-size: 0.7rem;
        color: #6e6e73;
    }

    /* ==========================================
       CONTACT SECTION
       ========================================== */
    .contact-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
    }

    .contact-card {
        background: #0d0d0d;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px;
        padding: 16px 8px;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 8px;
        text-decoration: none;
    }

    .contact-icon {
        width: 32px;
        height: 32px;
        background: rgba(0, 122, 255, 0.15);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .contact-icon svg {
        width: 16px;
        height: 16px;
        stroke: #007aff;
    }

    .contact-title {
        font-size: 0.7rem;
        font-weight: 600;
        color: #ffffff;
    }

    /* ==========================================
       FOOTER
       ========================================== */
    .footer {
        padding: 32px 16px 100px;
        text-align: center;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
    }

    .footer-logo {
        font-size: 1.1rem;
        font-weight: 800;
        margin-bottom: 6px;
    }

    .footer-text {
        font-size: 0.75rem;
        color: #6e6e73;
        margin-bottom: 12px;
    }

    .footer-copy {
        font-size: 0.65rem;
        color: #6e6e73;
    }

    /* ==========================================
       BOTTOM DOCK
       ========================================== */
    .mobile-dock-wrapper {
        position: fixed;
        bottom: 12px;
        left: 12px;
        right: 12px;
        z-index: 10001;
    }

    .mobile-dock {
        display: flex;
        justify-content: space-around;
        background: rgba(10, 10, 10, 0.95);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 14px;
        padding: 6px 4px;
    }

    .mobile-dock-item {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 6px 2px;
        color: #6e6e73;
        text-decoration: none;
        border-radius: 8px;
    }

    .mobile-dock-item svg {
        width: 18px;
        height: 18px;
        margin-bottom: 2px;
    }

    .dock-label {
        font-size: 0.5rem;
    }

    .mobile-dock-item.active {
        color: #007aff;
        background: rgba(0, 122, 255, 0.1);
    }

    /* ==========================================
       TERMINAL
       ========================================== */
    .terminal-wrapper {
        display: none !important;
    }

    .terminal-teaser {
        background: #0d0d0d;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px;
        padding: 14px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .terminal-teaser-icon {
        width: 36px;
        height: 36px;
        background: rgba(0, 122, 255, 0.15);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #007aff;
        font-weight: 700;
        font-size: 0.85rem;
    }

    /* ==========================================
       MODAL
       ========================================== */
    .project-nexus {
        padding: 0;
        align-items: flex-end;
    }

    .nexus-container {
        height: 85vh;
        max-width: 100%;
        border-radius: 16px 16px 0 0;
        background: #0a0a0a;
        border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .nexus-header {
        padding: 20px 16px 12px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }

    .nexus-title {
        font-size: 1.1rem;
        font-weight: 800;
    }

    .nexus-content {
        padding: 16px;
    }

    /* ==========================================
       HIDE VARIOUS ELEMENTS
       ========================================== */
    .skip-link,
    .quantum-firefly,
    .hero-bubble,
    .hero-micro-bubbles,
    .hero-image-glow {
        display: none !important;
    }

    /* ==========================================
       SAFE AREA
       ========================================== */
    @supports (padding-top: env(safe-area-inset-top)) {
        .hero {
            padding-top: calc(48px + env(safe-area-inset-top));
        }

        section {
            padding-left: calc(16px + env(safe-area-inset-left));
            padding-right: calc(16px + env(safe-area-inset-right));
        }

        .mobile-dock-wrapper {
            bottom: calc(12px + env(safe-area-inset-bottom));
        }

        .footer {
            padding-bottom: calc(100px + env(safe-area-inset-bottom));
        }
    }
}